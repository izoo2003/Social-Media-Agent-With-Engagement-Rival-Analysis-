# ============================================
# Kafi Social Agent Backend Environment File
# Copy to .env and customize for your setup
# ============================================

# App Settings
APP_NAME=Kafi Social Agent
# full = entire platform | creation-only = Prompt Studio API only (for junior deployment)
APP_MODE=full
API_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kafi_social_agent
DATABASE_ECHO=False
# Seconds to wait for a DB TCP connect before failing (lower = faster UI when DB is down)
DATABASE_CONNECT_TIMEOUT=5

# Supabase Settings (Alternative to local PostgreSQL)
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=Media

# Fast video processing (optional). Free API key from https://cloudconvert.com
# When set, large videos upload directly to CloudConvert (fast) instead of slow
# browser encoding. Falls back to browser processing if unset or if CloudConvert fails.
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_TARGET_HEIGHT=720
CLOUDCONVERT_CRF=28
CLOUDCONVERT_AUDIO_BITRATE_K=96
CLOUDCONVERT_POLL_TIMEOUT_SEC=600

# Ollama Settings (Local LLM - used when LLM_PROVIDER="ollama")
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=300

# Google Gemini Settings (used when LLM_PROVIDER="gemini" - preferred)
# Get a free API key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# LLM Parameters
TEMPERATURE=0.7
MAX_TOKENS=2048
TOP_P=0.9

# Content Creation chatbot — separate Gemini key from posting (GEMINI_API_KEY above)
# Optional: CREATION_GEMINI_API_KEYS=key2,key3 for quota failover (different Google accounts)
CREATION_GEMINI_API_KEY=
CREATION_GEMINI_API_KEYS=
CREATION_GEMINI_MODEL=gemini-2.5-flash
CREATION_GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Optional full model chain, e.g. gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
CREATION_GEMINI_MODELS=

# General Chatbot (Content Creation mode) — normal Q&A with model failover
GENERAL_CHAT_GEMINI_API_KEY=
# Optional extra keys (comma-separated) for quota failover
GENERAL_CHAT_GEMINI_API_KEYS=
GENERAL_CHAT_GEMINI_MODEL=gemini-2.5-flash
GENERAL_CHAT_GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Tried in order on rate limits / errors
GENERAL_CHAT_GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-pro

# OpenRouter — Claude dropdown in Content Creation (free Nemotron by default)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ChatGPT dropdown → Google Gemma 4 26B A4B (free)
OPENROUTER_CHATGPT_API_KEY=
OPENROUTER_CHATGPT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT=120
# Voice-over — Fish Audio S2.1 Pro Free
OPENROUTER_FISH_API_KEY=
OPENROUTER_FISH_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_FISH_TIMEOUT=120

# Prompt Studio — image generation
# Provider: gemini (recommended, clearer visuals) | modelslab | cloudflare
IMAGE_PROVIDER=gemini

# --- Google Gemini image (IMAGE_PROVIDER=gemini) ---
# Up to 3 dedicated slots. Rotation per request:
#   key1 base → key1 fallback → key2 base → key2 fallback → key3 base → key3 fallback
# If every slot is exhausted and Cloudflare is configured, text-only gens fall back to Flux.
STUDIO_IMAGE_GEMINI_API_KEY=
IMAGE_GEMINI_MODEL=gemini-2.5-flash-image
IMAGE_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-image
# Legacy multi-fallback list (first entry used if IMAGE_GEMINI_FALLBACK_MODEL is empty)
IMAGE_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-3-pro-image-preview,gemini-2.5-flash-image

STUDIO_IMAGE_GEMINI_API_KEY_2=
IMAGE_GEMINI_MODEL_2=gemini-3.1-flash-image
IMAGE_GEMINI_FALLBACK_MODEL_2=gemini-2.5-flash-image

STUDIO_IMAGE_GEMINI_API_KEY_3=
IMAGE_GEMINI_MODEL_3=gemini-2.5-flash-image
IMAGE_GEMINI_FALLBACK_MODEL_3=gemini-3.1-flash-image

# 0 = use all Gemini slots until exhausted (then Cloudflare if configured)
IMAGE_GEMINI_PRIORITY_COUNT=0
IMAGE_GEMINI_TIMEOUT=180

# --- ModelsLab (optional) ---
# Sign up at https://modelslab.com → Dashboard → API key. ~100 free calls/day.
MODELSLAB_API_KEY=
MODELSLAB_IMAGE_MODEL=hidream-o1
MODELSLAB_IMAGE_WIDTH=1024
MODELSLAB_IMAGE_HEIGHT=1024
MODELSLAB_INFERENCE_STEPS=31
MODELSLAB_GUIDANCE_SCALE=7.5
MODELSLAB_CLIP_SKIP=2
MODELSLAB_NEGATIVE_PROMPT=blurry, low quality, distorted, deformed, watermark, ugly
MODELSLAB_IMAGE_TIMEOUT=180

# --- Cloudflare Workers AI flux-1-schnell (optional rollback) ---
# To use again: set IMAGE_PROVIDER=cloudflare and fill the vars below.
# Account ID + API token: dash.cloudflare.com → Workers AI → Use REST API
# IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# When user attaches product/logo images — same Flux.2 family (multipart input_image_0…)
CLOUDFLARE_REFERENCE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_TIMEOUT=120

# Scraper Settings
SCRAPER_TIMEOUT=30
SCRAPER_BATCH_SIZE=10
SCRAPER_SCHEDULE_INTERVAL=3600

# Rival Review (competitor intelligence)
# YouTube Data API v3 key for PUBLIC competitor channel stats (free).
# Create one at https://console.cloud.google.com (enable "YouTube Data API v3").
# Optional if YouTube OAuth below is already configured — rivals will reuse upload OAuth.
# Instagram rival stats reuse FACEBOOK_PAGE_ACCESS_TOKEN + INSTAGRAM_ACCOUNT_ID below.
YOUTUBE_DATA_API_KEY=
# Set True to auto-refresh rival snapshots on SCRAPER_SCHEDULE_INTERVAL.
RIVAL_AUTO_REFRESH=False

# Redis (Optional Caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=False

# CORS Origins (localhost + optional explicit production URLs)
# Preview Vercel URLs change every deploy — CORS_ALLOW_VERCEL_REGEX handles *.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kafi-social-agent.vercel.app
CORS_ALLOW_VERCEL_REGEX=True
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# JWT/Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Dashboard login — required to protect API + frontend /dashboard routes
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
# Junior developer — Content Creation + posting (QA queue, no designer PIN prompt)
JUNIOR_DASHBOARD_USERNAME=junior
JUNIOR_DASHBOARD_PASSWORD=change-this-junior-password

# ---------------------------------------------------------------------------
# Security Hardening
# ---------------------------------------------------------------------------
# Internal API key required by destructive endpoints (e.g. DELETE /content/clear-all).
# Development: leave blank — a key is auto-generated on first run and saved to
#   backend/.internal_api_key (stable across restarts).
# Production/staging: set explicitly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
INTERNAL_API_KEY=

# PIN brute-force protection:
# Lock an IP for PIN_LOCKOUT_MINUTES after PIN_MAX_ATTEMPTS consecutive failures.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# Maximum JSON request body size (MB). Multipart uploads use
# max(MAX_REQUEST_BODY_MB, MAX_UPLOAD_SIZE_MB) so videos are not cut off early.
MAX_REQUEST_BODY_MB=200

# ---------------------------------------------------------------------------
# Social Media API Credentials
# ---------------------------------------------------------------------------

# LinkedIn (Developer App required: https://www.linkedin.com/developers)
# Account 1 (primary — backward compatible vars)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_ACCOUNT_1_LABEL=Account 1
# Accounts 2 & 3 (optional — posts fan out to all configured accounts)
LINKEDIN_ACCOUNT_2_LABEL=Account 2
LINKEDIN_ACCOUNT_2_ACCESS_TOKEN=
LINKEDIN_ACCOUNT_2_PERSON_ID=
LINKEDIN_ACCOUNT_3_LABEL=Account 3
LINKEDIN_ACCOUNT_3_ACCESS_TOKEN=
LINKEDIN_ACCOUNT_3_PERSON_ID=
LINKEDIN_ORGANIZATION_ID=
# Company-page analytics token (rw_organization_admin). Get via /api/v1/auth/linkedin
LINKEDIN_ORGANIZATION_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Live Railway backend (OAuth callbacks + auth links use this — not localhost)
BACKEND_PUBLIC_URL=https://kafi-social-media-agent-production.up.railway.app
# Leave blank to auto-derive from BACKEND_PUBLIC_URL
LINKEDIN_REDIRECT_URI=
# Posting (default). For company analytics use /auth/linkedin?purpose=analytics after MDP approval.
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_ANALYTICS_OAUTH_SCOPES=openid profile email rw_organization_admin

# Meta (Facebook & Instagram) - Create App at https://developers.facebook.com
# You need: Facebook Page + Instagram Business Account connected via Meta Business Suite
# Connect on Railway: https://kafi-social-media-agent-production.up.railway.app/api/v1/auth/meta
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Long-lived user token (~60 days). Auto-extended daily so Page tokens can be re-derived.
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0
# Seconds between Meta token maintenance runs (default: 24h)
META_TOKEN_REFRESH_INTERVAL_SECONDS=86400

# YouTube — OAuth app in Google Cloud Console (see README or docs below)
# While the app is in "Testing", refresh tokens expire ~7 days. Publish the OAuth app
# ("In production") for permanent refresh tokens.
# Connect on Railway: https://kafi-social-media-agent-production.up.railway.app/api/v1/auth/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=
YOUTUBE_CHANNEL_ID=
YOUTUBE_VIDEO_CATEGORY_ID=22
# Upload visibility: private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY_STATUS=public

# TikTok — app at https://developers.tiktok.com (Login Kit + Content Posting API)
# Register redirect URI, then connect:
# https://kafi-social-media-agent-production.up.railway.app/api/v1/auth/tiktok
# Sign in as the marketing TikTok account on TikTok's consent screen.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_REDIRECT_URI=
TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.upload,video.publish
# PUBLIC_TO_EVERYONE requires TikTok app audit; unaudited apps fall back to SELF_ONLY
TIKTOK_DEFAULT_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Draft / Test Mode (True = safe simulation, False = live posting)
DRAFT_MODE=False

# Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# ---------------------------------------------------------------------------
# Designer Approval Workflow (QA Checker)
# ---------------------------------------------------------------------------
# When True, non-designers must have their posts approved by the designer.
# Designers enter DESIGNER_PIN to post directly (skipping approval).
APPROVAL_REQUIRED=True
# Shared secret the designer uses to post directly and approve/reject in-app.
DESIGNER_PIN=
